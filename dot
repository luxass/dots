#!/usr/bin/env bash
# dot - dotfiles management CLI. Runs on the macOS system Bash (3.2).
set -euo pipefail

readonly DOT_VERSION="2.0.0"
DOTFILES_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
readonly DOTFILES_DIR

for lib in "$DOTFILES_DIR"/lib/core/*.sh "$DOTFILES_DIR"/lib/features/*.sh "$DOTFILES_DIR"/lib/commands/*.sh; do
  # shellcheck source=/dev/null
  source "$lib"
done
unset lib

main "$@"
