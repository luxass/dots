.DS_Store
*.bak
*.backup
*.tmp
*.zwc
.zcompdump*
.zsh_history
.node_history
.viminfo
node_modules/
.pnpm-store/
backups/
Brewfile.lock.json
packages/failed_packages_*.txt

# Secrets and auth state
**/.npmrc
!home/.npmrc
.gitconfig.local
home/.gitconfig.local
auth.json
*.pem
*.key
*.p12
*.pfx

# App-generated state
home/.config/fish/fish_variables
# CLI-managed fish completions regenerate on every CLI update; never track
home/.config/fish/completions/copilot.fish
home/.config/fish/completions/grok.fish
home/.config/fish/completions/pi.fish
home/.config/zed/conversations/
home/.config/zed/embeddings/
home/.config/zed/.tmp*
home/.config/raycast/

home/.config/opencode/node_modules/

# Herdr runtime/state
home/.config/herdr/*.log
home/.config/herdr/*.sock
home/.config/herdr/session.json
home/.config/herdr/session-history.json
home/.config/herdr/release-notes.json

# Pi agent runtime/state (blanket-ignore like dmmulroy/.dotfiles, allow-list customization only)
home/.pi/node_modules/
home/.pi/package-lock.json
home/.pi/agent/*
home/.pi/todos/*
home/.pi/.pi/todos/*
.pi/todos/*

# Pi MCP adapter runtime/secrets
home/.pi/agent/mcp-oauth/
home/.pi/agent/mcp-cache.json
home/.pi/agent/mcp-npx-cache.json
home/.pi/agent/mcp-auth.json
home/.pi/agent/models-store.json
home/.local/share/pi/mcp-auth.json

# Pi extensions node_modules
home/.pi/agent/extensions/**/node_modules/

!home/.pi/agent/tsconfig.json
!home/.pi/agent/package.json
!home/.pi/agent/cloak.json
!home/.pi/agent/themes/
!home/.pi/agent/themes/*.json
!home/.pi/agent/extensions/
!home/.pi/agent/extensions/**
!home/.pi/agent/mcp.json
!home/.pi/agent/APPEND_SYSTEM.md

home/.codex/auth.json

# CLIProxyAPI OAuth credentials; never commit
home/.config/cliproxyapi/auth/

# Vendored CLIProxyAPI web bundle: local-only, not tracked
home/.config/cliproxyapi/static/
