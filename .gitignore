.DS_Store
*.bak
*.backup
*.tmp
*.zwc
.zcompdump*
.zsh_history
.node_history
.viminfo
node_modules/
.pnpm-store/
backups/
Brewfile.lock.json
packages/failed_packages_*.txt

# Never re-track runtime leftovers from the retired home/ layout.
home/

# Secrets and auth state
**/.npmrc
!stow/runtime-policy/.npmrc
.gitconfig.local
auth.json
*.pem
*.key
*.p12
*.pfx

# Private Git overrides and included profiles stay outside the repository.
stow/git/.config/git/local.conf
stow/git/.config/git/extras

# GitHub CLI: preferences and extension sources only.
stow/gh/.config/gh/*
!stow/gh/.config/gh/config.yml
!stow/gh/.config/gh/extensions.txt

# Plannotator preferences only; reviews and credentials stay local.
stow/plannotator/.plannotator/*
!stow/plannotator/.plannotator/config.json

# Fish state and CLI-generated completions stay outside the package.
stow/fish/.config/fish/fish_variables
stow/fish/.config/fish/completions/copilot.fish
stow/fish/.config/fish/completions/grok.fish
stow/fish/.config/fish/completions/pi.fish
stow/fish/.config/fish/completions/docker.fish
stow/fish/.config/fish/completions/kubectl.fish
stow/fish/.config/fish/completions/orbctl.fish

# Rex configuration and themes only.
stow/rex/.config/rex/*
!stow/rex/.config/rex/init.lua
!stow/rex/.config/rex/macos-defaults.conf
!stow/rex/.config/rex/themes/

# Herdr downloads, registries, sessions, and sockets stay local.
stow/herdr/.config/herdr/plugins/
stow/herdr/.config/herdr/plugins.json
stow/herdr/.config/herdr/.plugins.lock
stow/herdr/.config/herdr/*.log
stow/herdr/.config/herdr/*.sock
stow/herdr/.config/herdr/*.sock.*
stow/herdr/.config/herdr/session.json
stow/herdr/.config/herdr/session-history.json
stow/herdr/.config/herdr/session-snapshots/
stow/herdr/.config/herdr/release-notes.json

# Pi preferences and customizations only, never runtime state.
stow/pi/.pi/package-lock.json
stow/pi/.pi/agent/*
stow/pi/.pi/todos/
stow/pi/.pi/.pi/todos/
.pi/todos/
!stow/pi/.pi/agent/tsconfig.json
!stow/pi/.pi/agent/package.json
!stow/pi/.pi/agent/cloak.json
!stow/pi/.pi/agent/mcp.json
!stow/pi/.pi/agent/settings.json
!stow/pi/.pi/agent/AGENTS.md
!stow/pi/.pi/agent/themes/
!stow/pi/.pi/agent/themes/*.json
!stow/pi/.pi/agent/extensions/
!stow/pi/.pi/agent/extensions/**
!stow/pi/.pi/agent/voice-settings.json

# OpenCode service configuration can contain credentials and private URLs.
stow/opencode/.config/opencode/service.json
stow/opencode/.config/opencode/service-*.json
