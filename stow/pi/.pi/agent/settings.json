{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "packages": [
    "npm:@luxass/pi-voice",
    "npm:@luxass/pi-whimsical",
    "npm:@luxass/pi-btw",
    "npm:@luxass/pi-personal",
    "npm:@luxass/pi-questions",
    "npm:@luxass/pi-resources",
    "npm:@luxass/pi-cost-explorer",
    "npm:@plannotator/pi-extension",
    "git:github.com/dmmulroy/pi-claude-cli",
    "npm:@luxass/pi-subagents",
    "git:github.com/dmmulroy/rex-sdk"
  ],
  "theme": "catppuccin-latte/catppuccin-macchiato",
  "defaultProvider": "crow",
  "defaultModel": "gpt-6.2-sol",
  "quietStartup": true,
  "deviceId": "a98c376d-aecc-4851-a8e5-ecff6f8824fb",
  "defaultTools": [
    "+codemode"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "enableAnalytics": false,
  "subagents": {
    "preferredProviders": [
      "pi-claude-cli",
      "crow"
    ]
  },
  "notices": {
    "cacheMisses": true,
    "cacheWarming": true,
    "compactionCosts": true,
    "reasoningDrops": true
  }
}